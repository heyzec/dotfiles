{
  // SETTINGS FROM DEFAULT PROFILE {{{
  "inheritProfile.parents": [
    "Default"
  ],
  // --- INHERITED SETTINGS MARKER START --- //
  // WARNING: Do not remove the inherited settings start and end markers.
  //          The markers are used to identify inserted inherited settings.
  "[javascript][javascriptreact][typescript][typescriptreact].editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript][javascriptreact][typescript][typescriptreact].editor.formatOnSave": true,
  "[json][jsonc].editor.defaultFormatter": "esbenp.prettier-vscode",
  "[json][jsonc].editor.formatOnSave": true,
  "chat.disableAIFeatures": true,
  "debug.toolBarLocation": "commandCenter",
  "editor.cursorBlinking": "solid",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.guides.bracketPairs": "active",
  "editor.lineNumbers": "relative",
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.size": "fill",
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "extensions.experimental.affinity": {"asvetliakov.vscode-neovim":1},
  "files.autoSave": "afterDelay",
  "files.insertFinalNewline": false,
  "files.trimFinalNewlines": false,
  "files.trimTrailingWhitespace": false,
  "git.openRepositoryInParentFolders": "never",
  "gitblame.delayBlame": 250,
  "gitblame.inlineMessageEnabled": true,
  "gitblame.inlineMessageFormat": "${author.name} (${time.ago})",
  "gitblame.inlineMessageMargin": 2,
  "gitblame.statusBarMessageFormat": "${commit.summary}",
  "terminal.integrated.commandsToSkipShell": ["-workbench.action.quickOpen"],
  "update.mode": "none",
  "vscode-neovim.compositeKeys.jk.command": "vscode-neovim.escape",
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.useModal": "off",
  "workbench.tree.enableStickyScroll": true,
  // --- INHERITED SETTINGS MARKER END --- //
  "inheritProfile._insertionBoundary": false
}
